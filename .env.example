# ── Leni Notes · configuration ──────────────────────────────────────────────
# Copie ce fichier en `.env.local` et remplis les valeurs.

# Clé OpenAI (Whisper pour la transcription audio + modèle de chat pour
# l'enrichissement des notes). Laisse vide pour utiliser le mode "mock"
# (heuristiques locales, aucun appel réseau).
OPENAI_API_KEY=

# Modèles OpenAI (optionnel)
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Token secret que le Raccourci iOS envoie dans `Authorization: Bearer <token>`.
# Génère-en un avec :  openssl rand -hex 24
CAPTURE_TOKEN=change-me

# Mot de passe (optionnel) pour protéger l'interface web quand elle sera
# exposée sur Internet. Laisse vide en local.
APP_PASSWORD=

# Base de données (libsql). En local : fichier SQLite. Plus tard : URL Turso.
DATABASE_URL=file:./data/leni.db
DATABASE_AUTH_TOKEN=

# Dossier où sont conservés les enregistrements audio reçus.
AUDIO_DIR=./data/audio
# Stockage audio : "local" (disque) ou "none" (serverless : transcrit puis
# oublié). Vide = détection automatique.
AUDIO_STORAGE=

# ── Cloud (Vercel + Turso) ──────────────────────────────────────────────────
# Voir DEPLOY.md. Sur Vercel, définir :
#   DATABASE_URL=libsql://<nom>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token turso>
#   APP_PASSWORD=<mot de passe web>
#   AUDIO_STORAGE=none
#   OPENAI_API_KEY, CAPTURE_TOKEN, OPENAI_MODEL, LENI_USER_NAME

# Nombre de notes partageant une même proposition de thème avant que Leni
# crée le thème automatiquement (voir README, « Thèmes émergents »).
THEME_EMERGENCE_THRESHOLD=2

# Prénom affiché sur l'accueil
LENI_USER_NAME=

# Fuseau horaire de l'utilisateur (dates, regroupement par jour, série)
LENI_TIMEZONE=Europe/Paris
